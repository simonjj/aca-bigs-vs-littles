ARG PROCESS_MODEL=single

FROM node:22.20.0-alpine3.22 AS base

WORKDIR /app

ENV NODE_ENV=production

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force

COPY server.js ecosystem.config.cjs ./

EXPOSE 3000

USER node

FROM base AS single
CMD ["node", "server.js"]

FROM base AS pm2
CMD ["./node_modules/.bin/pm2-runtime", "ecosystem.config.cjs"]

FROM ${PROCESS_MODEL} AS final
